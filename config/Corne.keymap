        // layer 2
        navigation_layer = {
            bindings = <
//+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
    &none                 &none                 &kp LC(PG_UP)       &kp LC(PG_DN)       &none                 &none                     &kp PG_UP           &kp HOME            &kp UP              &kp END             &kp BLSH            &none
//+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
    &none                 &kp LALT            &kp LSHFT           &kp LCTRL           &none                 &none                     &kp PG_DN           &kp LEFT            &kp DOWN            &kp RIGHT           &kp DEL             &none
//+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
    &none                 &kp LGUI            &kp PG_UP           &kp PG_DN           &none                 &none                     &kp RC(Z)           &none                 &none                 &none                 &none                 &none
//+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
                                                                &none                 &none                 &none                     &none                 &none                 &none
//                                                            +-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+
            >;
            display-name = "NAV";
        };

