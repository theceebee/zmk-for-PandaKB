    keymap {
        compatible = "zmk,keymap";

        // layer 0
        base_layer {
            bindings = <
//+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
    &kp TAB             &kp Q               &kp W               &kp E               &kp R               &kp T                   &kp Y               &kp U               &kp I               &kp O               &kp P               &kp BSPC
//+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
    &kp CAPS            &mt LALT A          &lt 1 S             &mt LSHFT D         &lt 2 F             &kp G                   &kp H               &lt 2 J             &mt RSHFT K         &lt 1 L             &mt RALT SEMI       &kp SQT
//+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
    &mo 3               &mt LGUI Z          &kp X               &kp C               &mt LCTRL V         &kp B                   &kp N               &mt RCTRL M         &kp COMMA           &kp DOT             &mt RGUI FSLH       &kp RET
//+-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+-------------------+-------------------+-------------------+
                                                                &kp LGUI            &kp UNDER           &kp SPACE               &kp BSPC            &kp ESC             &mo 6
//                                                            +-------------------+-------------------+-------------------+   +-------------------+-------------------+-------------------+
            >;
            display-name = "BASE";
        };

//         // layer 1
//         symbol_layer {
